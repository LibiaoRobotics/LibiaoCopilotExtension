									"effort": "medium"
								},
								"properties": {
									"effort": {
										"type": "string",
										"default": "medium",
										"enum": [
											"max",
											"xhigh",
											"high",
											"medium",
											"low",
											"minimal",
											"auto"
										],
										"description": "OpenRouter/xAI 的推理强度级别（high、medium、low、minimal、auto）"
									},
									"exclude": {
										"type": "boolean",
										"default": false,
										"description": "从最终响应中排除推理 token"
									},
									"max_tokens": {
										"type": "number",
										"default": 2000,
										"minimum": 1,
										"description": "推理部分的专用 token 上限（Anthropic 风格，可替代 effort）"
									},
									"enabled": {
										"type": "boolean",
										"default": true,
										"description": "启用推理（未指定时会根据 effort 或 max_tokens 自动推断）"
									}
								},
								"description": "OpenRouter 兼容供应商的推理配置"
							},
							"extra": {
								"type": "object",
								"description": "额外的请求体参数。"
							},
							"headers": {
								"type": "object",
								"additionalProperties": {
									"type": "string"
								},
								"description": "每次向该模型供应商发起请求时携带的自定义 HTTP 请求头。这些请求头会与默认请求头（Authorization、Content-Type、User-Agent）合并。"
							},
							"include_reasoning_in_request": {
								"type": "boolean",
								"default": false,
								"description": "发送给 API 的助手消息中是否包含 reasoning_content。支持 deepseek-v3.2 等模型。"
							},
							"apiMode": {
								"type": "string",
								"enum": [
									"openai",
									"openai-responses",
									"ollama",
									"anthropic",
									"gemini"
								],
								"default": "openai",
								"description": "API 模式：'openai'（默认）为 OpenAI Chat Completions（/chat/completions），'openai-responses' 为 OpenAI Responses（/responses），'ollama' 为 Ollama（/api/chat），'anthropic' 为 Anthropic（/messages，baseUrl 需包含版本前缀 /v1），'gemini' 为 Gemini（*/v1beta/models/{model}:streamGenerateContent?alt=sse）。"
							},
							"useForCommitGeneration": {
								"type": "boolean",
								"default": false,
								"description": "是否用于 Git 提交信息生成。不支持 gemini apiMode。"
							},
							"delay": {
								"type": "number",
								"default": 0,
								"minimum": 0,
								"description": "连续请求之间的延迟（毫秒）。未指定时回退到全局配置 libiaoCopilot.delay。"
							},
							"cache_control": {
								"type": "boolean",
								"default": true,
								"description": "启用 Anthropic 提示词缓存断点（仅 apiMode='anthropic' 生效）。设为 true 时会为系统提示词和最后一个工具定义附加 cache_control={type:'ephemeral'}，并转发 Copilot 消息中携带的 cache_control 标记。若上游供应商拒绝 cache_control 字段，请设为 false。"
							}
						},
						"required": [
							"id"
						],
						"anyOf": [
							{
								"required": [
									"owned_by"
								]
							},
							{
								"required": [
									"provider"
								]
							},
							{
								"required": [
									"provide"
								]
							}
						]
					},
					"description": "首选模型列表及其元数据（上下文长度、推理强度等）。模型仍会从 API 实时发现：每个已配置模型会与其自身端点的模型列表核对（供应商侧不存在的将被移除），API 中未配置的模型会以默认元数据自动展示。若端点无法查询（未配置地址或 API Key，或拉取失败），则不展示该端点的任何模型，绝不展示未核实条目；刷新失败但有缓存时以过期缓存兜底；全部端点都无法查询时以不可选占位条目说明原因。"
				},
				"libiaoCopilot.retry": {
					"type": "object",
					"default": {
						"enabled": true,
						"max_attempts": 3,
						"interval_ms": 1000,
						"status_codes": []
					},
					"properties": {
						"enabled": {
							"type": "boolean",
							"default": true,
							"description": "启用 API 错误重试机制。默认 true。"
						},
						"max_attempts": {
							"type": "number",
							"default": 3,
							"minimum": 1,
							"description": "最大重试次数。默认 3。"
						},
						"interval_ms": {
							"type": "number",
							"default": 1000,
							"minimum": 1,
							"description": "重试间隔（毫秒）。默认 1000（1 秒）。"
						},
						"status_codes": {
							"type": "array",
							"items": {
								"type": "number"
							},
							"description": "额外需要触发重试的 HTTP 状态码。默认为 [429, 500, 502, 503, 504]。"
						}
					},
					"description": "针对 [429, 500, 502, 503, 504] 等 API 错误的重试配置。"
				},
				"libiaoCopilot.delay": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"description": "连续请求之间的固定延迟（毫秒）。默认 0（无延迟）。"
				},
				"libiaoCopilot.modelCacheTtlMinutes": {
					"type": "number",
					"default": 10,
					"minimum": 0,
					"description": "供应商模型列表缓存的 TTL（分钟）。缓存有效期内直接返回缓存、不请求供应商；刷新失败时返回过期缓存。设为 0 可禁用缓存，每次请求都实时拉取。"
				},
				"libiaoCopilot.commitLanguage": {
					"type": "string",
					"default": "Chinese (Simplified)",
					"enum": [
						"English",
						"French",
						"Italian",
						"German",
						"Spanish",
						"Russian",
						"Chinese (Simplified)",
						"Chinese (Traditional)",
						"Japanese",
						"Korean",
						"Czech",
						"Portuguese (Brazil)",
						"Turkish",
						"Polish"
					],
					"description": "生成 Git 提交信息所用的语言。默认为简体中文。"
				},
				"libiaoCopilot.commitMessagePrompt": {
					"type": "string",
					"default": "",
					"description": "提交信息生成的自定义系统提示词。不提供时使用默认提示词。"
				},
				"libiaoCopilot.readFileLines": {
					"type": "number",
					"default": 0,
					"minimum": 0,
					"maximum": 10000,
					"description": "使用 `read_file` 工具时读取的行数。行数过多可能消耗更多 token。默认 0，由模型自行决定行数。"
				},
				"libiaoCopilot.contextManagement": {
					"type": "string",
					"enum": [
						"off",
						"summarize"
					],
					"enumDescriptions": [
						"不管理上下文：历史原样发送（超限时可能被网关拒绝）。",
						"历史超过所选上下文窗口时，自动把较早的对话压缩成摘要；摘要失败时自动降级为硬截断。"
					],
					"default": "summarize",
					"description": "对话历史超过所选上下文窗口时的处理方式。默认 summarize：压缩旧历史保留前文大意。仅当模型在 Configure 菜单里有可选上下文档位时生效。"
				},
				"libiaoCopilot.summarizationInstructions": {
					"type": "string",
					"default": "",
					"description": "附加到上下文摘要提示词的自定义指令（可选）。例如：\"摘要必须保留所有报错信息\"。"
				},
				"libiaoCopilot.summarizeMaxTokens": {
					"type": "number",
					"default": 4000,
					"minimum": 256,
					"maximum": 32768,
					"description": "上下文摘要的最大输出 token 数。默认 4000。"
				}
			}
		}
	},
	"main": "./out/extension.js",
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"download-api": "dts dev && mv vscode.proposed.*.ts src",
		"compile": "tsc -p ./",
		"lint": "eslint",
		"format": "prettier --write .",
		"watch": "tsc -watch -p ./",
		"test": "npm run compile && vscode-test",
		"build": "vsce package -o extension.vsix"
	},
	"dependencies": {
		"@microsoft/tiktokenizer": "^1.0.10"
	},
	"devDependencies": {
		"@eslint/js": "^9.13.0",
		"@stylistic/eslint-plugin": "^2.9.0",
		"@types/mocha": "^10.0.6",
		"@types/node": "^22",
		"@types/vscode": "^1.104.0",
		"@vscode/dts": "^0.4.1",
		"@vscode/test-cli": "^0.0.11",
		"@vscode/test-electron": "^2.5.2",
		"@vscode/vsce": "^3.9.2",
		"eslint": "^9.13.0",
		"mocha": "^11.8.0",
		"prettier": "^3.1.0",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.39.0"
	}
}
