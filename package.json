{
	"name": "libiao-copilot",
	"publisher": "libiaorobot",
	"displayName": "Libiao Copilot",
	"description": "立镖机器人的 OpenAI 兼容模型供应商扩展，为 GitHub Copilot Chat 提供模型支持",
	"author": {
		"name": "LIBIAO ROBOTICS HOLDINGS PTE. LTD."
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/LibiaoRobotics/LibiaoCopilotExtension.git"
	},
	"homepage": "https://marketplace.visualstudio.com/items?itemName=libiaorobot.libiao-copilot",
	"bugs": {
		"url": "https://github.com/LibiaoRobotics/LibiaoCopilotExtension/issues"
	},
	"pricing": "Free",
	"icon": "assets/logo.png",
	"keywords": [
		"ai",
		"chat",
		"copilot",
		"github-copilot",
		"language-model",
		"llm",
		"openai",
		"ollama",
		"anthropic",
		"claude",
		"gemini",
		"openai-compatible",
		"openai-responses",
		"git-commit",
		"thinking"
	],
	"version": "1.0.7",
	"engines": {
		"vscode": "^1.120.0"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"categories": [
		"AI",
		"Chat"
	],
	"license": "MIT",
	"enabledApiProposals": [
		"chatProvider"
	],
	"contributes": {
		"languageModelChatProviders": [
			{
				"vendor": "libiao-copilot",
				"displayName": "Libiao Copilot",
				"managementCommand": "libiaoCopilot.setApikey"
			}
		],
		"commands": [
			{
				"command": "libiaoCopilot.setApikey",
				"category": "Libiao Copilot",
				"title": "设置 API Key"
			},
			{
				"command": "libiaoCopilot.setProviderApikey",
				"category": "Libiao Copilot",
				"title": "设置供应商 API Key"
			},
			{
				"command": "libiaoCopilot.openConfig",
				"category": "Libiao Copilot",
				"title": "打开配置界面"
			},
			{
				"command": "libiaoCopilot.generateGitCommitMessage",
				"title": "使用 Libiao Copilot 生成提交信息",
				"category": "Libiao Copilot",
				"icon": "$(wand)"
			},
			{
				"command": "libiaoCopilot.abortGitCommitMessage",
				"title": "使用 Libiao Copilot 生成提交信息 - 停止",
				"category": "Libiao Copilot",
				"icon": "$(debug-stop)"
			}
		],
		"menus": {
			"scm/title": [
				{
					"command": "libiaoCopilot.generateGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && !libiaoCopilot.isGeneratingCommit"
				},
				{
					"command": "libiaoCopilot.abortGitCommitMessage",
					"group": "navigation",
					"when": "config.git.enabled && scmProvider == git && libiaoCopilot.isGeneratingCommit"
				}
			],
			"commandPalette": [
				{
					"command": "libiaoCopilot.generateGitCommitMessage",
					"when": "config.git.enabled && !libiaoCopilot.isGeneratingCommit"
				},
				{
					"command": "libiaoCopilot.abortGitCommitMessage",
					"when": "config.git.enabled && libiaoCopilot.isGeneratingCommit"
				}
			]
		},
		"configuration": {
			"title": "Libiao Copilot",
			"properties": {
				"libiaoCopilot.logLevel": {
					"type": "string",
					"default": "off",
					"enum": [
						"off",
						"debug",
						"info",
						"warn",
						"error"
					],
					"description": "调试日志级别。日志以 JSON Lines 格式写入 ~/.copilot/libiao-copilot/logs/。默认 'off'（不记录日志）。"
				},
				"libiaoCopilot.baseUrl": {
					"type": "string",
					"default": "",
					"description": "OpenAI 兼容 API 的基础地址（例如 https://your-gateway.com/v1）。未配置时不会拉取模型列表。"
